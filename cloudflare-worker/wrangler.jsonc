{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-vision-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "YoutubeVisionMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["YoutubeVisionMCP"] }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash"
  },
  "observability": {
    "enabled": true
  }
}
