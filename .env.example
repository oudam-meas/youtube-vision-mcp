# Copy this file to ~/.config/youtube-vision-mcp/.env and fill in your key.
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=your-api-key-here

# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Only needed if you're deploying cloudflare-worker/ — the same value you
# pass to `npm run secret:auth-token` there. Cloudflare secrets are
# write-only (no API/dashboard ever returns the value back), so this file
# is the only place the raw token lives; generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=your-generated-token-here
