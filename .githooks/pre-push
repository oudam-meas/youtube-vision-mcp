#!/usr/bin/env bash
# Free, dependency-free secret scanner run before every `git push`.
# Blocks the push if likely secrets are found in the outgoing commits.
#
# Installed via: git config core.hooksPath .githooks
set -euo pipefail

remote="$1"
zero=0000000000000000000000000000000000000000
found=0

# Regexes for common secret shapes. Kept generic on purpose since this
# repo only uses a Gemini key today, but pushes could add others later.
patterns=(
  'AIza[0-9A-Za-z_-]{35}'                       # Google API key
  'AKIA[0-9A-Z]{16}'                             # AWS access key id
  'ghp_[0-9A-Za-z]{36}'                          # GitHub PAT
  'github_pat_[0-9A-Za-z_]{50,}'                 # GitHub fine-grained PAT
  'sk-[A-Za-z0-9]{20,}'                          # OpenAI-style secret key
  'xox[baprs]-[0-9A-Za-z-]{10,}'                 # Slack token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'           # PEM private key
  '[A-Za-z0-9_-]*[Ss][Ee][Cc][Rr][Ee][Tt][A-Za-z0-9_-]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'
  '[A-Za-z0-9_-]*[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'
)

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref, nothing to scan

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"       # new branch: scan everything reachable from it
  else
    range="$remote_sha..$local_sha"
  fi

  # Block if .env itself is tracked in what's being pushed.
  if git diff --name-only "$range" 2>/dev/null | grep -qx '\.env'; then
    echo "pre-push: refusing to push — .env is tracked in commit range $range" >&2
    found=1
  fi

  for pat in "${patterns[@]}"; do
    hits=$(git log -p "$range" 2>/dev/null | grep -E "^\+" | grep -Ev '^\+\+\+' | grep -E -e "$pat" || true)
    if [ -n "$hits" ]; then
      echo "pre-push: possible secret matching /$pat/ found in $range:" >&2
      echo "$hits" | sed 's/^/    /' >&2
      found=1
    fi
  done
done

if [ "$found" -ne 0 ]; then
  echo "pre-push: aborting push. Remove the secret (and rewrite history if already committed)," >&2
  echo "or if this is a false positive, push with --no-verify." >&2
  exit 1
fi

exit 0
